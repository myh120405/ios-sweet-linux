+/*
+ * How many instances of className IOKit has published right now. Called from
+ * the reporter thread in bsd/dev/sweet_ufs.c a few seconds into the boot (and
+ * again later) and written straight into the persistent ring, so the answer
+ * survives even when boot-arg sweetquiet=1 has muted the console. A class that
+ * matched shows up here whether or not its start() printed anything.
+ */
+extern "C" unsigned int
+sweet_service_count(const char *className)
+{
+	OSDictionary *matching;
+	OSIterator *found;
+	unsigned int n = 0;
+
+	if (className == NULL) {
+		return 0;
+	}
+	matching = IOService::serviceMatching(className);
+	if (matching == NULL) {
+		return 0;
+	}
+	found = IOService::getMatchingServices(matching);
+	matching->release();
+	if (found != NULL) {
+		while (found->getNextObject() != NULL) {
+			n++;
+		}
+		found->release();
+	}
+	return n;
+}
