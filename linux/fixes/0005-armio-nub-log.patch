+		IOLog("SWEET: arm-io children %u\n", count);
+		createNubs(this, entries);
 		armio->release();
 	}
 
+	/*
+	 * The whole device-tree map, bounded: if the panel node is not below
+	 * /arm-io this is where it (or its absence) shows up, and it is also the
+	 * answer to "which compatible strings does this DT actually have".
+	 */
+	{
+		OSIterator *all = IODTFindMatchingEntries(root, kIODTRecursive, NULL);
