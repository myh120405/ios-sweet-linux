+/*
+ * ---- sweetquiet=1 and the post-mute service report --------------------
+ *
+ * The console ring keeps its LAST 4 MiB, so the launchd flood pushes the
+ * early boot log out of it and a dump could only ever show the tail.
+ * sweetquiet=1 (read at the first user-space exec, see bsd/kern/kern_exec.c)
+ * makes _cnputs() stop *before* the ring append, so the ring keeps the head;
+ * the ring and the flush path are not touched.
+ *
+ * Once muted nothing else writes to the ring, and these counts are what a
+ * dump needs: AppleKeyStore is the control (published from the same
+ * ConfigTable, known to work), IOPlatformDevice counts the nubs this expert
+ * created, AppleCLCD and IOCoreSurfaceRoot are what the display needs. The
+ * line is padded past the 8 KiB flush step on purpose, so appending it also
+ * flushes the ring to the partition - the only copy a dump can read once the
+ * console has gone silent.
+ */
+extern "C" {
+int sweet_console_silent = 0;
+}
+
+extern "C" void
+sweet_console_quiet_start(void)
+{
+	static int started;
+	int on = 0;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (PE_parse_boot_argn("sweetquiet", &on, sizeof(on)) && on != 0) {
+		sweet_console_silent = 1;
+	}
+}
+
+extern "C" void sweet_log_append(const char *c, int size);	/* bsd/dev/sweet_ufs.c */
+
+static char *
+sweet_put_str(char *p, const char *text)
+{
+	while (*text != '\0') {
+		*p++ = *text++;
+	}
+	return p;
+}
+
+static char *
+sweet_put_uint(char *p, unsigned int v)
+{
+	char tmp[12];
+	int n = 0;
+
+	do {
+		tmp[n++] = (char)('0' + (v % 10));
+		v /= 10;
+	} while (v != 0);
+	while (n > 0) {
+		*p++ = tmp[--n];
+	}
+	return p;
+}
+
+static void
+sweet_service_report(const char *when)
+{
+	static char line[9216];
+	static const char *names[4] = {
+		"AppleCLCD", "IOPlatformDevice", "IOCoreSurfaceRoot", "AppleKeyStore"
+	};
+	char *p = line;
+
+	p = sweet_put_str(p, "SWEET: services(");
+	p = sweet_put_str(p, when);
+	p = sweet_put_str(p, ")");
+	for (int i = 0; i < 4; i++) {
+		*p++ = ' ';
+		p = sweet_put_str(p, names[i]);
+		*p++ = '=';
+		p = sweet_put_uint(p, sweet_service_count(names[i]));
+	}
+	/* pad past the 8 KiB flush step so this append also flushes */
+	while (p < line + sizeof(line) - 2) {
+		*p++ = '.';
+	}
+	*p++ = '\n';
+	sweet_log_append(line, (int)(p - line));
+}
+
+static void
+sweet_report_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	IOSleep(3000);
+	sweet_service_report("3s");
+	IOSleep(5000);
+	sweet_service_report("8s");
+	IOSleep(7000);
+	sweet_service_report("15s");
+}
+
+static void
+sweet_report_start(void)
+{
+	static int started;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (kernel_thread_start(sweet_report_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * How many instances of className IOKit has published right now. A class that
+ * matched shows up here whether or not its start() printed anything.
+ */
+static unsigned int
+sweet_service_count(const char *className)
+{
+	OSDictionary *matching;
+	OSIterator *found;
+	unsigned int n = 0;
+
+	if (className == NULL) {
+		return 0;
+	}
+	matching = IOService::serviceMatching(className);
+	if (matching == NULL) {
+		return 0;
+	}
+	found = IOService::getMatchingServices(matching);
+	matching->release();
+	if (found != NULL) {
+		while (found->getNextObject() != NULL) {
+			n++;
+		}
+		found->release();
+	}
+	return n;
+}
