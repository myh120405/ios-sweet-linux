+
+		if (all != NULL) {
+			IORegistryEntry *e;
+			while ((e = (IORegistryEntry *)all->getNextObject()) != NULL) {
+				OSData *comp = (OSData *)e->getProperty("compatible");
+				nodes++;
+				if (nodes <= 400) {
+					IOLog("SWEET: dt[%u] %s = '%s'\n", nodes,
