@@ -712,6 +712,31 @@ sweet_ufs_init(void)
 
 static char sweet_log_ring[SWEET_LOG_SIZE];
 static uint64_t _Atomic sweet_log_total;
+
+/*
+ * sweetquiet=1: set at the first user-space exec (bsd/kern/kern_exec.c), read
+ * by _cnputs() (osfmk/console/serial_console.c) *before* the ring append. The
+ * console then stops completely - nothing drawn, nothing added to the ring -
+ * so the 4 MiB ring keeps the early boot log (SWEET EARLY .. IOKit publish)
+ * instead of the launchd flood that used to push it out. The ring and the
+ * flush path are untouched; the flag only stops new input.
+ */
+int sweet_console_silent;
+
+void
+sweet_console_quiet_start(void)
+{
+	static int started;
+	int on = 0;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (PE_parse_boot_argn("sweetquiet", &on, sizeof(on)) && on != 0) {
+		sweet_console_silent = 1;
+	}
+}
 static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
@@ -780,6 +805,60 @@ sweet_log_append(const char *c, int size)
 	}
 }
 
+/*
+ * Append a line straight to the persistent ring, bypassing the console. With
+ * sweetquiet=1 printf() no longer reaches the ring, so a diagnostic that runs
+ * after the mute has to write here to be seen in a dump.
+ */
+void
+sweet_log_note(const char *text)
+{
+	size_t len;
+
+	if (text == NULL) {
+		return;
+	}
+	len = strlen(text);
+	if (len > 0) {
+		sweet_log_append(text, (int)len);
+	}
+}
+
+/*
+ * IOKit published its services by the time this runs: report how many
+ * instances of the classes that matter exist, a few seconds apart. This is the
+ * one question a dump could not answer before - AppleCLCD::start()'s own
+ * printf is gone from a wrapped ring, while these counts are not.
+ */
+extern unsigned int sweet_service_count(const char *className);	/* SweetPlatformExpert.cpp */
+
+static void
+sweet_service_report(const char *when)
+{
+	char line[192];
+	unsigned int clcd, nubs, surf, aks;
+
+	clcd = sweet_service_count("AppleCLCD");
+	nubs = sweet_service_count("IOPlatformDevice");
+	surf = sweet_service_count("IOCoreSurfaceRoot");
+	aks = sweet_service_count("AppleKeyStore");
+	snprintf(line, sizeof(line),
+	    "SWEET: services(%s) AppleCLCD=%u IOPlatformDevice=%u IOCoreSurfaceRoot=%u AppleKeyStore=%u\n",
+	    when, clcd, nubs, surf, aks);
+	sweet_log_note(line);
+}
+
+static void
+sweet_service_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	tsleep(&sweet_log_chan, PZERO, "sweetsvc", 3 * hz);
+	sweet_service_report("3s");
+	tsleep(&sweet_log_chan, PZERO, "sweetsvc", 12 * hz);
+	sweet_service_report("15s");
+}
+
