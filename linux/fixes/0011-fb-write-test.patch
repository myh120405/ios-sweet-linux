diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 14fe2aa..1cac78d 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -206,2 +206,69 @@ AppleCLCD::start(IOService *provider)
 	registerService();
+
+	/*
+	 * Cache-attribute experiment. The panel is mapped write-combining
+	 * (kIOMapWriteCombineCache): writes may sit in the write-combining buffer
+	 * until something forces them out, while reads still see them - which is
+	 * exactly "read back is right but the panel never changes".
+	 *
+	 *   sweetfb_uncached=1  remap the panel uncached (kIOMapInhibitCache)
+	 *   wtest               write 16 red pixels, dsb, read, dsb, read again
+	 */
+	{
+		uint32_t before[4] = { 0, 0, 0, 0 };
+		uint32_t after[4] = { 0, 0, 0, 0 };
+		uint32_t flushed[4] = { 0, 0, 0, 0 };
+		int uncached = 0;
+		unsigned int mapopt = 4;        /* kIOMapWriteCombineCache */
+
+		PE_parse_boot_argn("sweetfb_uncached", &uncached, sizeof(uncached));
+		if (uncached && fPhys != 0 && fRowBytes != 0 && fHeight != 0) {
+			IOMemoryDescriptor *mem = IOMemoryDescriptor::withPhysicalAddress(
+			    (IOPhysicalAddress)fPhys,
+			    (IOByteCount)fRowBytes * (IOByteCount)fHeight,
+			    kIODirectionOut);
+
+			if (mem != NULL) {
+				IOMemoryMap *m = mem->map(kIOMapInhibitCache);
+
+				if (m != NULL) {
+					OSSafeReleaseNULL(fMap);
+					fMap = m;
+					fPixels = (uintptr_t)m->getVirtualAddress();
+					mapopt = 1;     /* kIOMapInhibitCache */
+				}
+				mem->release();
+			}
+		}
+
+		{
+			volatile uint32_t *p = (volatile uint32_t *)fPixels;
+
+			printf("SWEET FB: wtest addr phys=%#llx pixels=%#llx row=%u early=%#llx map_type=%u uncached=%d\n",
+			    (unsigned long long)fPhys, (unsigned long long)fPixels,
+			    fRowBytes, 0x9c000000ULL, mapopt, uncached);
+			if (p != NULL) {
+				for (int i = 0; i < 4; i++) {
+					before[i] = p[i];
+				}
+				for (int i = 0; i < 16; i++) {
+					p[i] = 0xFFFF0000u;
+				}
+				__asm__ volatile("dsb sy" ::: "memory");
+				for (int i = 0; i < 4; i++) {
+					after[i] = p[i];
+				}
+				__asm__ volatile("dsb sy" ::: "memory");
+				for (int i = 0; i < 4; i++) {
+					flushed[i] = p[i];
+				}
+				printf("SWEET FB: wtest before=%08x %08x %08x %08x after=%08x %08x %08x %08x\n",
+				    before[0], before[1], before[2], before[3],
+				    after[0], after[1], after[2], after[3]);
+				printf("SWEET FB: wtest flushed=%08x %08x %08x %08x\n",
+				    flushed[0], flushed[1], flushed[2], flushed[3]);
+			}
+		}
+	}
+
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
