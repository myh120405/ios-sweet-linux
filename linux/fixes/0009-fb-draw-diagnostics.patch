+			if (sweet_present_call <= 3) {
+				sweet_fb_note("present-skip",
+				    ((unsigned long long)layer << 32) | (unsigned long long)id,
+				    mask, (unsigned long long)(1u << layer), 0);
+			}
 			continue;
 		}
 		SweetSurface *s = sweet_surface_copy(id);
@@ -393,6 +532,14 @@ AppleCLCD::present(const uint8_t *rec)
 		    s->memory == NULL || last > s->memory->getLength()) {
 			src = 0;
 		}
+		if (sweet_present_call <= 3) {
+			sweet_fb_note("present-layer",
+			    ((unsigned long long)layer << 32) | (unsigned long long)id,
+			    (unsigned long long)src,
+			    ((unsigned long long)(uint32_t)w << 32) | (unsigned long long)(uint32_t)h,
+			    (unsigned long long)(fPixels + (uint64_t)dy * fRowBytes +
+			    (uint64_t)dx * 4));
+		}
 		if (src != 0 && bpe == 4) {
 			for (int32_t y = 0; y < h; y++) {
 				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
@@ -400,6 +547,15 @@ AppleCLCD::present(const uint8_t *rec)
 				    (size_t)w * 4);
 			}
 		}
+		if (sweet_present_call <= 3 && w > 0 && h > 0) {
+			volatile uint32_t *dst = (volatile uint32_t *)
+			    (fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4);
+			sweet_fb_note("present-landed", (unsigned long long)dst,
+			    dst[0], dst[1], (unsigned long long)w * 4);
+			sweet_fb_flush_range((void *)dst, (unsigned long)w * 4);
+			sweet_fb_note("present-flushed", (unsigned long long)dst,
+			    dst[0], dst[1], 0);
+		}
 		s->release();
 	}
 }
