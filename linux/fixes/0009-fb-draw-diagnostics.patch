--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -37,6 +37,94 @@
 #include "SweetSurface.h"
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" void sweet_log_append(const char *c, int size);      /* bsd/dev/sweet_ufs.c */
+
+/*
+ * Drawing diagnostics. printf() is muted by boot-arg sweetquiet=1 (that is how
+ * the ring keeps the early boot log), so every line here goes straight into
+ * the persistent ring instead. Four numbers per line, formatted by hand: no
+ * printf-family declaration is needed in this translation unit.
+ */
+static char *
+sweet_put_str(char *p, const char *text)
+{
+	while (*text != '\0') {
+		*p++ = *text++;
+	}
+	return p;
+}
+
+static char *
+sweet_put_hex(char *p, unsigned long long v)
+{
+	static const char digits[] = "0123456789abcdef";
+	char tmp[16];
+	int n = 0;
+
+	*p++ = '0';
+	*p++ = 'x';
+	do {
+		tmp[n++] = digits[v & 0xf];
+		v >>= 4;
+	} while (v != 0);
+	while (n > 0) {
+		*p++ = tmp[--n];
+	}
+	return p;
+}
+
+static void
+sweet_note4(const char *prefix, const char *tag, unsigned long long a,
+    unsigned long long b, unsigned long long c, unsigned long long d)
+{
+	char line[192];
+	char *p = line;
+	const unsigned long long values[4] = { a, b, c, d };
+
+	p = sweet_put_str(p, prefix);
+	p = sweet_put_str(p, ": ");
+	p = sweet_put_str(p, tag);
+	for (int i = 0; i < 4; i++) {
+		*p++ = ' ';
+		p = sweet_put_hex(p, values[i]);
+	}
+	*p++ = '\n';
+	sweet_log_append(line, (int)(p - line));
+}
+
+static void
+sweet_fb_note(const char *tag, unsigned long long a, unsigned long long b,
+    unsigned long long c, unsigned long long d)
+{
+	sweet_note4("SWEET FB", tag, a, b, c, d);
+}
+
+/* Called from pexpert/arm/pe_serial.c (the text console on the panel). */
+extern "C" void
+sweet_fbcon_note(const char *tag, unsigned long long a, unsigned long long b,
+    unsigned long long c, unsigned long long d)
+{
+	sweet_note4("SWEET FBCON", tag, a, b, c, d);
+}
+
+/*
+ * Clean+invalidate the cache lines covering a range and wait for the writes to
+ * reach memory. The early console writes the panel through a VA=PA non-cacheable
+ * mapping; if the driver's mapping comes back cached instead, the pixels stay in
+ * the CPU cache and the panel (which is not coherent) never sees them. Writing,
+ * flushing by hand and looking at the screen tells these two apart.
+ */
+extern "C" void
+sweet_fb_flush_range(void *addr, unsigned long len)
+{
+	uintptr_t p = (uintptr_t)addr & ~(uintptr_t)63u;
+	uintptr_t end = (uintptr_t)addr + len;
+
+	for (; p < end; p += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}     /* osfmk/console/serial_console.c */
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
@@ -206,6 +294,35 @@ AppleCLCD::start(IOService *provider)
 	registerService();
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+
+	/*
+	 * Is the panel memory the kernel mapped really the one the shim is
+	 * scanning? Read the first pixels (the shim's text is there), paint 16
+	 * of them red, read back. If vram-pre is zero/garbage the mapping points
+	 * elsewhere; if vram-post does not read back as 0xffff0000 the memory is
+	 * not writable; if both are right and the screen still does not change,
+	 * the panel is scanning another buffer.
+	 */
+	sweet_fb_note("start", (unsigned long long)fPhys, (unsigned long long)fPixels,
+	    ((unsigned long long)fWidth << 32) | (unsigned long long)fRowBytes,
+	    ((unsigned long long)fHeight << 32) | (unsigned long long)fLogicalW);
+	{
+		extern int disableConsoleOutput;
+		volatile uint32_t *px = (volatile uint32_t *)fPixels;
+
+		sweet_fb_note("console-state", (unsigned long long)sweet_console_muted,
+		    (unsigned long long)disableConsoleOutput,
+		    (unsigned long long)fConsolePaused, 0);
+		/* What is in the panel memory right now: the early console's text? */
+		sweet_fb_note("vram-pre", px[0], px[1], px[2], px[3]);
+		for (int i = 0; i < 16; i++) {
+			px[i] = 0xFFFF0000u;
+		}
+		sweet_fb_note("vram-post", px[0], px[1], px[2], px[3]);
+		/* Same 16 pixels, now with the cache cleaned by hand. */
+		sweet_fb_flush_range((void *)px, 16 * 4);
+		sweet_fb_note("vram-flushed", px[0], px[1], px[2], px[3]);
+	}
 	return true;
 }
 
