#!/bin/bash
# Minimal xcrun replacement for building XNU on Linux. The kernel makefiles only ask for
# the SDK path/version/platform and for tools that are on PATH (mig, unifdef, iig, the
# cctools); this answers those and nothing else.
HB=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
sdk=""; find=""; show=""
while [ $# -gt 0 ]; do case "$1" in
  -sdk|--sdk) sdk="$2"; shift 2;;
  -verbose) shift;;
  -find|--find|-f) find="$2"; shift 2;;
  -show-sdk-path|--show-sdk-path) show=path; shift;;
  -show-sdk-version|--show-sdk-version) show=version; shift;;
  -show-sdk-platform-path|--show-sdk-platform-path) show=platform; shift;;
  -show-sdk-platform-version) show=version; shift;;
  *) break;;
esac; done
SDKP="${XNU_SDK_PATH:?XNU_SDK_PATH not set}"
case "$show" in
  path) case "$sdk" in /*) echo "$sdk";; *) echo "$SDKP";; esac; exit 0;;
  version) echo "${XNU_SDK_VERSION:-16.5}"; exit 0;;
  platform) echo "${XNU_PLATFORM_PATH:-$SDKP/Platforms/iPhoneOS.platform}"; exit 0;;
esac
if [ -n "$find" ]; then
  # cctools and the host tools are earlier on PATH than /usr/bin (linux/env.sh); the
  # fallbacks keep `xcrun -find clang` working when PATH has been reset.
  command -v "$find" 2>/dev/null && exit 0
  for d in "$HB" /usr/bin; do [ -x "$d/$find" ] && { echo "$d/$find"; exit 0; }; done
  exit 1
fi
[ $# -gt 0 ] && exec "$@"
